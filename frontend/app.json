{
  "expo": {
    "name": "TheraMotion",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/theramotion-icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/489e559d-3f76-4432-bb50-38fe53af7013"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.theramotion.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/theramotion-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-video",
      "expo-audio",
      "expo-font",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/theramotion-splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "489e559d-3f76-4432-bb50-38fe53af7013"
      }
    }
  }
}
