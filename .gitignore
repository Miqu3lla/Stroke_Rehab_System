# Node / Expo
frontend/node_modules/
frontend/.expo/
frontend/.expo-shared/

# Python
backend/.venv/
backend/venv/
backend/__pycache__/
backend/**/*.pyc

# Model artifacts
backend/models/*.pth
backend/models/*.pkl
# ...except the small (~1MB) per-exercise LSTM checkpoints, which MUST ship with
# the code: if missing, that exercise silently falls back to the global model and
# misclassifies. sit_to_stand intentionally uses the global model, so it has none.
!backend/models/lstm_knee_extension.pth
!backend/models/lstm_shoulder_flexion.pth
!backend/models/lstm_hand_to_mouth.pth

# Datasets (large media — kept local, not tracked)
datasets/

# Generated voice-over clips (staging for Storage upload; regenerated offline)
backend/assets/voice/

# Environment files
.env
.env.*

# OS files
.DS_Store
Thumbs.db

# Editor / tooling
.claude/

backend/db/
